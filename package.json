{
  "name": "Gimme-That",
  "version": "2.0.0",
  "main": "main.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "util/build.py",
    "build:cleanup": "rimraf bundles",
    "build:bundles": "webpack",
    "build:regexps": "node util/makexregexps.js > data/xregexps.json",
    "stats": "cloc --vcs=git --exclude-lang=Markdown,SVG",
    "test": "LANG=en mocha -r ts-node/register -r chai/register-expect.js tests",
    "watch": "webpack --watch",
    "webext": "web-ext run -i 'lib/*' -i '**/node_modules/**' --bc -p ../GT.p --keep-profile-changes "
  },
  "author": "Manas Doshi",
  "license": "GPL-2.0",
  "devDependencies": {
    "@types/node": "^12.7.8",
    "@typescript-eslint/eslint-plugin": "^2.3.2",
    "@typescript-eslint/parser": "^2.3.2",
    "chai": "^4.1.2",
    "eslint": "^6.5.1",
    "mocha": "^6.2.1",
    "rimraf": "^3.0.2",
    "ts-loader": "^6.2.0",
    "ts-node": "^8.4.1",
    "typescript": "^3.6.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.0.2",
    "xregexp": "^5.1.1"
  },
  "dependencies": {
    "@types/psl": "^1.1.0",
    "@types/whatwg-mimetype": "^3.0.0",
    "localforage": "^1.9.0",
    "psl": "^1.4.0",
    "tslib": "^1.14.1",
    "web-ext": "^8.9.0",
    "webextension-polyfill": "^0.10.0",
    "whatwg-mimetype": "^3.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
